<Window x:Class="FarmSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Farma Simulátor" Height="650" Width="950">

    <DockPanel LastChildFill="True">

        <StackPanel DockPanel.Dock="Top" Height="60" Background="#7C5437" Orientation="Horizontal">

            <Image Source="/Images/obrazky/Farmar.png" Width="40" Height="40" Margin="10,0,10,0"/>

            <TextBlock x:Name="TxtPeniaze" Text="0" Foreground="Orange" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>

            <Image Source="/Images/obrazky/obrPeniaze.png" Width="30" Height="30" Margin="10,0,10,0"/>
            <Button x:Name="BtnPosunCas" Content="Posunúť čas (+1)" Click="BtnPosunCas_Click" 
        Margin="50,12,10,12" Padding="15,0" Background="Orange" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0"/>

        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="LightGreen">
                <UniformGrid x:Name="OhradyGrid" Rows="3" Columns="2" Margin="10"/>
            </DockPanel>

            <DockPanel Grid.Column="1" Background="LightGreen">
                <Button x:Name="BtnObchod" Click="BtnObchod_Click" DockPanel.Dock="Top" Margin="10" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <StackPanel>
                        <Image Source="/Images/obrazky/shop.png" Width="70" Height="70" Stretch="Uniform"/>
                        <TextBlock Text="Obchod" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Border BorderBrush="Green" BorderThickness="1,0,1,0" />
            </DockPanel>

            <DockPanel Grid.Column="2" Background="LightGreen">
                <Button x:Name="BtnSklad" Click="BtnSklad_Click" DockPanel.Dock="Top" Margin="10" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center">
                    <StackPanel>
                        <Image Source="/Images/obrazky/sklad.png" Width="70" Height="70" Stretch="Uniform"/>
                        <TextBlock Text="Sklad" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <UniformGrid x:Name="PoliaGrid" Rows="6" Columns="6" Margin="15,0,15,15" VerticalAlignment="Top"/>
            </DockPanel>

        </Grid>

    </DockPanel>
</Window>